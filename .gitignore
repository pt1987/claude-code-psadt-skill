# Machine-local runtime state created by setup - NEVER commit
config.json
secret.dpapi

# Auto-downloaded content-prep tool (provisioned + version-checked by the skill)
tools/

# Safety net: never commit any secret/key artifacts
*.dpapi
*.pfx
*.cer
*.key
secrets.*

# OS / Editor
Thumbs.db
desktop.ini
.DS_Store
.vs/
.idea/

# Pester / test artifacts
testResults*.xml
_pester.out

# Local planning / specs (superpowers) - NEVER commit, stays local
docs/superpowers/

# Per-machine Claude Code permission overrides - personal, never part of the shipped skill
.claude/settings.local.json

# Migrated legacy config/secret left behind by Initialize-PsadtSkill.ps1 -Fix (kept, never deleted)
*.migrated

# Eval run output - HTML reports and per-run JSON, regenerated on every `claude plugin eval` run
evals/results/

# A config home can be placed INSIDE the skill folder (Get-PsadtConfig.ps1 -SkillRoot), and the
# machine-local store that lands there must never be committed: it is this machine's own record.
verified-switches.json
# The SHIPPED layer is the exception, and it is deliberate. It travels with the skill so a fresh
# installation starts with what earlier gate runs proved, keyed by installer SHA256 - the same bytes,
# whoever ran them. A user's machine-local file extends it; the reader merges both and local wins.
!references/switch-catalog/verified-switches.json
